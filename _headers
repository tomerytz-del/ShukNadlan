# ============================================================================
# כותרות HTTP של Netlify — אבטחה ומטמון
#
# הקובץ מפורסם משורש הריפו יחד עם ה-HTML, בדיוק כמו ‎_redirects‎.
# ‏Netlify מחיל אותו על כל בקשה; אין צורך בשום הגדרה בדשבורד.
#
# התחביר: שורת נתיב בלי הזחה, ואחריה שורות ‎Header: value‎ מוזחות.
# הכלל הספציפי ביותר גובר, ו-‎/*‎ הוא ברירת המחדל.
# ============================================================================

/*
  # ‏clickjacking: דף ה-CRM הוא לוח מחוונים מחובר עם ארנק ויתרת אשראי.
  # בלי הכותרת הזו אפשר לטעון אותו ב-iframe שקוף מעל אתר אחר ולגרום
  # לסוכן/ת ללחוץ על כפתורים שהוא/היא לא רואה. אף דף באתר אינו מיועד
  # להיטמע אצל צד שלישי, ולכן DENY ולא SAMEORIGIN.
  X-Frame-Options: DENY

  # הדפדפן מכבד את ‎Content-Type‎ שהשרת שלח ולא מנחש לפיו. בלי זה קובץ
  # שהועלה כתמונה ומכיל HTML עלול להתפרש כ-HTML ולרוץ במקור של האתר.
  X-Content-Type-Options: nosniff

  # ‏Referer מלא דולף כתובות פנימיות (‏?id=… של נכס, טוקן בקישור ניהול)
  # לכל דומיין חיצוני שמקשרים אליו. origin בלבד לחוצה-דומיין, נתיב מלא
  # בתוך האתר — כך ש-GA4 עדיין רואה מאיפה לאיפה עברו.
  Referrer-Policy: strict-origin-when-cross-origin

  # חסימת ממשקים שאף דף באתר אינו משתמש בהם. המשמעות המעשית היא שה-iframe
  # של יוטיוב/וימאו בדף נכס לא יוכל לבקש מצלמה, מיקרופון או מיקום מהצופה.
  #
  # ‏‎geolocation=(self)‎ ולא ‎()‎: כפתור "הצג נכסים לידי" בדף הבית
  # (‏assets/near-me.js) מבקש מיקום כדי לבחור את השוק המקומי. ‎(self)‎ פותח
  # אותו לדפים שלנו בלבד - לא ל-iframe של צד שלישי. בלי השינוי הזה הכפתור
  # היה נראה תקין ולא עושה כלום: ‎geolocation=()‎ חוסם בלי בקשת הרשאה, בלי
  # שגיאה בקונסול, וה-callback פשוט לא נקרא. ‏docs/regional-pages.md.
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)

  # ‏HTTPS בלבד לשנה. בלי ‎preload‎ ובלי ‎includeSubDomains‎ בכוונה: שניהם
  # דלת חד-כיוונית שקשה לחזור ממנה, ותת-דומיין עתידי שיוגש ב-HTTP (סביבת
  # בדיקות, דף נחיתה של ספק) היה נחסם בדפדפנים שכבר ראו את הכותרת.
  Strict-Transport-Security: max-age=31536000

  # ---------------------------------------------------------------------
  # ‏CSP — במצב דיווח בלבד, ובכוונה.
  #
  # חיבור התגיות ב-GTM עדיין לא הושלם, וכל תגית שתתווסף שם (פיקסל של מטא,
  # ‏GA4, רימרקטינג) טוענת סקריפט מדומיין שאינו ברשימה למטה. מדיניות
  # **אכיפה** הייתה חוסמת אותן בשקט — כלומר בדיוק את המדידה שהאתר הזה
  # בנוי סביבה — ואת זה מגלים חודש אחרי, כשהנתונים אבודים.
  #
  # ‏Report-Only אינו חוסם כלום: הוא רק כותב לקונסול של הדפדפן כל דבר
  # שהיה נחסם. איך לעבור לאכיפה:
  #
  #   1. לסיים את חיבור התגיות ב-GTM.
  #   2. לעבור על דף הבית, דף נכס, דף משרד, ה-CRM והתשלום עם הקונסול
  #      פתוח, ולאסוף כל שורת ‏"Refused to…" .
  #   3. להוסיף את הדומיינים שעלו לרשימה המתאימה כאן.
  #   4. לשנות את שם הכותרת ל-‎Content-Security-Policy‎ (בלי הסיומת).
  #
  # ‏'unsafe-inline' ב-script-src אינו בחירה אלא מצב נתון: כל דף באתר הוא
  # קובץ עצמאי שכל הקוד שלו יושב ב-‎<script>‎ בתוכו (ראו CLAUDE.md). ניקוי
  # אמיתי דורש nonce לכל טעינה — כלומר שרת — ולכן אינו רלוונטי כאן.
  # עדיין יש ערך: ‎object-src 'none'‎, ‎base-uri 'self'‎ ו-‎frame-ancestors‎
  # חוסמים וקטורים אמיתיים גם עם unsafe-inline.
  # ---------------------------------------------------------------------
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.govmap.gov.il; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://obookujgolazrwycsiyn.supabase.co wss://obookujgolazrwycsiyn.supabase.co https://www.googletagmanager.com https://www.google-analytics.com https://tiles.openfreemap.org https://tile.openstreetmap.org https://cdn.jsdelivr.net https://*.govmap.gov.il; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.googletagmanager.com https://*.govmap.gov.il; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ---------------------------------------------------------------------------
# מטמון
#
# ‏HTML, JS ו-CSS **אינם** מקבלים כאן מטמון ארוך בכוונה. לשמות הקבצים אין
# חתימת תוכן (‏app.a1b2c3.js), ולכן מטמון ארוך היה מגיש גרסה ישנה אחרי
# מיזוג — וזה סותר את מה שהאתר הזה נשען עליו: פרסום תוך שניות מהמיזוג.
# ברירת המחדל של Netlify לקבצים האלה היא אימות מחדש מול ETag, שמחזיר 304
# קצר כשאין שינוי. זה הדבר הנכון כאן, ולכן לא נוגעים בו.
#
# מה שכן: הנכסים הבינאריים. לוגו, אייקון והתמונה החלופית אינם משתנים
# בפועל, ושומרים אותם יום — מספיק כדי לחסוך בקשה בכל ניווט בין דפים
# (לאתר אין תבנית משותפת, ולכן כל מעבר בין דפים הוא טעינה מלאה), וקצר
# מספיק כדי שהחלפת לוגו תתפוס למחרת בלי התערבות.
# ---------------------------------------------------------------------------

/assets/*.png
  Cache-Control: public, max-age=86400

/assets/*.jpg
  Cache-Control: public, max-age=86400

/assets/*.svg
  Cache-Control: public, max-age=86400

/promoted.png
  Cache-Control: public, max-age=86400

# ---------------------------------------------------------------------------
# ‏PWA — המניפסטים וה-Service Worker
#
# שני דברים כאן, ושניהם שקטים כשהם שבורים:
#
# ‏1. **‏Content-Type.** דפדפן שמקבל את המניפסט כ-‎text/plain‎ מתעלם ממנו,
#    והאתר פשוט מפסיק להיות ניתן להתקנה — בלי שגיאה ובלי סימן בדף. ‏Netlify
#    מזהה ‎.webmanifest‎ נכון היום, וההצהרה כאן היא ביטוח מפני היום שבו לא.
#
# ‏2. **מטמון ה-Worker.** ‏‎sw.js‎ עצמו חייב להיבדק מול השרת בכל טעינה,
#    אחרת גרסה חדשה שלו (למשל זו שמבטלת אותו, ראו ההערה בקובץ) תמתין
#    במטמון של הדפדפן במקום להיכנס לתוקף. ‏no-cache אינו "בלי מטמון" אלא
#    "לאמת מול השרת לפני כל שימוש" — כלומר 304 קצר כשאין שינוי.
#
# האייקונים עצמם הם ‎/assets/*.png‎ ונופלים תחת הכלל של יום למעלה.
# ---------------------------------------------------------------------------

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/app-crm.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8
