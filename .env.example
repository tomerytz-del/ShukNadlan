# מנוע הלידים מפידי RSS — הרצה מקומית. אין להעלות קובץ .env אמיתי ל-git.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://obookujgolazrwycsiyn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# אופציונלי
# CLAUDE_MODEL=claude-sonnet-5
# RSS_FEED_URLS=https://rss.app/feeds/aaa.xml,https://rss.app/feeds/bbb.xml
# MAX_NEW_LEADS_PER_RUN=60
# MIN_SCORE_TO_PUBLISH=1

# --- מנוע מבזקי הנדל"ן (docs/news-ticker.md) ---
# חולק את SUPABASE_* ואת ANTHROPIC_API_KEY שלמעלה — אין סודות חדשים.
# ‏ANTHROPIC_API_KEY אופציונלי כאן: בלעדיו המנוע רץ בניסוח היוריסטי.
# הפידים יושבים בטבלת news_sources. אלה מתווספים אליהם, ונפרדים מ-RSS_FEED_URLS.
# NEWS_FEED_URLS=https://example.com/rss.xml,https://example.org/feed
# MAX_NEW_NEWS_PER_RUN=25
# הסף לפרסום ברצועה (1–10). העלאה מהדקת את הרצועה לידיעות מקומיות.
# MIN_NEWS_SCORE_TO_PUBLISH=5
# ידיעה ישנה מזה אינה מבזק ולא נכנסת
# NEWS_MAX_AGE_DAYS=21

# --- מנגנון הדמיות הנכסים (docs/property-visualizations.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# בלי GEMINI_API_KEY שלוש הפונקציות נפרסות בהצלחה ומחזירות gemini_not_configured
# רק בזמן ריצה — הסקציה בדף הנכס עולה, הטופס נשלח, ואף הדמיה לא נוצרת.
# לבדיקת מצב: scripts/visualizations_setup.sql (חלק 1).
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# למילוי לאחור של נכסים שכבר מפורסמים — scripts/visualizations_backfill.sh.
# המפתח נמסר כמשתנה סביבה להרצה בודדת ואינו נשמר בקובץ:
#   SUPABASE_SERVICE_ROLE_KEY=eyJ... scripts/visualizations_backfill.sh --dry-run

# --- הסוכן החכם: התראות למחפשי דירה (docs/smart-search-agent.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# SITE_BASE_URL=https://shuknadlan.co.il
# שם תבנית וואטסאפ מאושרת. בלעדיו נשלח טקסט חופשי, שנכשל מול מי שלא כתב לנו.
# WHATSAPP_ALERT_TEMPLATE=
# WHATSAPP_ALERT_TEMPLATE_LANG=he
# RESEND_API_KEY=
# ALERTS_FROM_EMAIL=

# --- הזמנת סוכן/ת למשרד (docs/agent-invitations.md) ---
# משתמש באותם RESEND_API_KEY ו-ALERTS_FROM_EMAIL שלמעלה. בלעדיהם ההזמנה עדיין
# נוצרת והקישור מוצג למנהל/ת להעתקה — רק המייל לא יוצא.
# בסיס הקישור שנשלח במכתב ההזמנה. ברירת המחדל היא https://shuknadlan.co.il
# SITE_BASE_URL=https://shuknadlan.co.il
# הידוק הגישה ל-saved-search-notify. חייב להיות זהה לסוד alert_cron_secret ב-Vault.
# ALERT_CRON_SECRET=

# --- תיאור שיווקי לנכס (docs/marketing-description.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# הפונקציה property-description כותבת תיאור שיווקי לכל נכס שנשמר בלעדיו, עם
# אותו ANTHROPIC_API_KEY ו-CLAUDE_MODEL שלמעלה. אין לה סודות משלה: בלי המפתח
# היא מחזירה copy_not_configured ולא נוגעת בתור.

# --- סרטון שיווקי לנכס (docs/property-marketing-video.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# הפונקציה property-video מפיקה סרטון מהתמונות שכבר במודעה, בשתי רמות:
# מצגת (בלי AI, לכל סוכן/ת) ורחפן AI (image-to-video, ל-Premium).
# בלי FAL_KEY הפונקציה נפרסת בהצלחה ומחזירה fal_not_configured בזמן ריצה.
# FAL_KEY=
# מודל image-to-video. החלפה כאן היא ההחלפה היחידה שנדרשת — אין קוד שתלוי
# במודל מסוים. עלויות והשוואה בטבלה שבתיעוד.
# FAL_VIDEO_MODEL=fal-ai/wan-i2v
# FAL_COMPOSE_MODEL=fal-ai/ffmpeg-api/compose
# מוזיקת רקע. ריק בכוונה, ואין קובץ מוזיקה בריפו: רצועה בסרטון שמתפרסם
# בפייסבוק ובוואטסאפ היא שאלת רישוי, וקובץ שנכנס לכאן הופך את הפלטפורמה
# לאחראית עליו. מי שמפעיל מעלה רצועה שיש לו רישיון עליה ומצביע לכאן.
# בלי הסוד הזה הסרטון נוצר בלי פס קול — וזה תקין.
# MARKETING_VIDEO_MUSIC_URL=
# בחירת התמונות נשענת על הסיווג של ההדמיות ומשתמשת באותו GEMINI_API_KEY
# שלמעלה. בלעדיו הבחירה נופלת לסדר הגלריה — סרטון פחות מסודר, אבל סרטון.
# לבדיקת התאמה מול fal לפני ההפעלה:  FAL_KEY=xxx scripts/fal_video_probe.sh

# --- פרסום לפייסבוק (docs/facebook-auto-publish.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# צריך אחד משני מסלולי הפרסום. אם שניהם מוגדרים — Make מנצח.
# מסלול Make (מומלץ — בלי אפליקציית Meta ובלי טוקן שפג):
# MAKE_FACEBOOK_WEBHOOK_URL=
# MAKE_WEBHOOK_SECRET=
# מסלול Graph API ישיר:
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v23.0

# --- בדיקת וובהוק הוואטסאפ (scripts/whatsapp_webhook_test.py) ---
# חייבים להיות זהים לסודות שמוגדרים ב-Supabase → Edge Functions → Secrets,
# אחרת החתימה לא תתאים והפונקציה תחזיר 401.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# מספר לבדיקה, בפורמט שבו Meta שולחת — קידומת מדינה בלי פלוס ובלי אפס מוביל
WA_TEST_FROM=9725XXXXXXXX
