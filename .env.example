# מנוע הלידים מפידי RSS — הרצה מקומית. אין להעלות קובץ .env אמיתי ל-git.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://obookujgolazrwycsiyn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# אופציונלי
# CLAUDE_MODEL=claude-sonnet-5
# RSS_FEED_URLS=https://rss.app/feeds/aaa.xml,https://rss.app/feeds/bbb.xml
# MAX_NEW_LEADS_PER_RUN=60
# MIN_SCORE_TO_PUBLISH=1

# --- מנגנון הדמיות הנכסים (docs/property-visualizations.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# --- הסוכן החכם: התראות למחפשי דירה (docs/smart-search-agent.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# SITE_BASE_URL=https://shuknadlan.co.il
# שם תבנית וואטסאפ מאושרת. בלעדיו נשלח טקסט חופשי, שנכשל מול מי שלא כתב לנו.
# WHATSAPP_ALERT_TEMPLATE=
# WHATSAPP_ALERT_TEMPLATE_LANG=he
# RESEND_API_KEY=
# ALERTS_FROM_EMAIL=

# --- הזמנת סוכן/ת למשרד (docs/agent-invitations.md) ---
# משתמש באותם RESEND_API_KEY ו-ALERTS_FROM_EMAIL שלמעלה. בלעדיהם ההזמנה עדיין
# נוצרת והקישור מוצג למנהל/ת להעתקה — רק המייל לא יוצא.
# בסיס הקישור שנשלח במכתב ההזמנה. ברירת המחדל היא https://shuknadlan.co.il
# SITE_BASE_URL=https://shuknadlan.co.il
# הידוק הגישה ל-saved-search-notify. חייב להיות זהה לסוד alert_cron_secret ב-Vault.
# ALERT_CRON_SECRET=

# --- תיאור שיווקי ופרסום לפייסבוק (docs/facebook-auto-publish.md) ---
# מוגדר ב-Supabase → Edge Functions → Secrets, לא כאן. מופיע לתיעוד בלבד.
# התיאור השיווקי נכתב עם אותו ANTHROPIC_API_KEY ו-CLAUDE_MODEL שלמעלה.
# צריך אחד משני מסלולי הפרסום. אם שניהם מוגדרים — Make מנצח.
# מסלול Graph API ישיר (מומלץ כאן — רץ על אותה אפליקציית Meta ו-System User
# של בוט הוואטסאפ, בלי תלות חיצונית ובלי טוקן שפג):
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v23.0
# מסלול Make — כשרוצים לפצל לכמה ערוצים או לשנות את הפוסט בלי פריסה:
# MAKE_FACEBOOK_WEBHOOK_URL=
# MAKE_WEBHOOK_SECRET=

# --- בדיקת וובהוק הוואטסאפ (scripts/whatsapp_webhook_test.py) ---
# חייבים להיות זהים לסודות שמוגדרים ב-Supabase → Edge Functions → Secrets,
# אחרת החתימה לא תתאים והפונקציה תחזיר 401.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# מספר לבדיקה, בפורמט שבו Meta שולחת — קידומת מדינה בלי פלוס ובלי אפס מוביל
WA_TEST_FROM=9725XXXXXXXX
