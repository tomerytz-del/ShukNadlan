<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: לא מגבים לענן ולא מעבירים למכשיר חדש את העוגיות, ה-session
     וההעדפות. אסימון כניסה שעובר למכשיר אחר הוא סיכון, ובמכשיר החדש נכנסים מחדש. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
